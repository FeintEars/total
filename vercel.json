{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nestjs",
  "buildCommand": "npm run build && npm run migration:deploy",
  "regions": ["fra1"],
  "schedules": {
    "telegram-subscriptions": {
      "schedule": "0 6 * * *",
      "path": "/telegram/subscriptions/send",
      "requestMethod": "POST"
    }
  }
}
